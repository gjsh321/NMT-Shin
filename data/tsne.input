{"stype": "Sentence", "agent": "M5", "tr": "\"즉 이 카메라로는 공간을 감지하는 데에도 제한이 있고, 확보할 수 있는 시야도 150m 밖에 되지 않는다.\"", "doc_org": " Sie bilden die Umwelt also nur begrenzt räumlich ab und haben nur eine Reichweite von 150 Metern.", "doc": "T2", "embedding": [0.388397, 0.692963, 0.22384, 0.329738, -0.206049, -0.708611, 0.39439, -0.181327, 0.62671, -0.389097, -0.263933, 0.653686, 0.424534, -0.731467, -0.179709, 0.366511, -0.815384, 0.241022, 0.645595, -0.280354, 0.186522, -0.604066, 0.161136, 0.277737, 1.031235, -0.383931, 0.776018, 0.110354, -0.447429, -0.691151, 0.354626, 0.116082, -0.030829, -0.49212, -0.1461, 1.171538, -0.527112, 0.257654, 0.787277, 0.297446, 0.161463, 0.350865, -0.594242, 0.144728, -1.205582, 0.075623, -0.146319, 0.318141, 0.762824, -0.565325, 0.492661, -0.227932, 0.375065, 0.089947, -1.086474, -0.293767, 0.375133, -0.129747, 0.190006, 0.235123, -0.562157, -0.034334, -0.335738, -0.940304, 0.413425, 0.861669, 0.479333, -0.186691, 0.792868, 1.34549, 0.369703, -0.158041, -0.444979, -0.323285, -0.400331, -0.279502, 0.552294, 0.473831, -0.068403, 0.247757, -0.412222, -0.750205, -0.494117, -0.079266, 0.489524, 0.451045, -0.094869, 0.120839, 0.342374, 0.678322, -0.108108, -0.27023, -0.521999, 0.540209, -0.358466, 0.22871, -1.429553, 0.278243, -0.632348, 0.505648, 0.066962, 0.686913, -0.794584, -0.003442, 0.494739, 0.001306, -0.098716, 0.954101, -0.246153, -0.433927, 0.674836, 0.878054, 0.243325, -0.042451, -0.097751, 0.048678, 0.12828, 0.205376, -0.116606, -0.537333, -0.089542, 0.234854, 0.328689, -0.27757, -0.616958, -0.404372, 0.092251, 0.239958, 0.653047, -0.676454, 0.876064, -1.310929, -0.125012, 0.329375, -0.041877, -0.583377, -0.12434, 0.505485, -0.345714, 1.036647, -0.139335, 0.101142, -0.187938, 0.395431, 0.529677, 0.181841, -0.073263, 0.681889, -0.275779, -0.253067, 0.355592, -0.067403, -0.124958, 0.497901, -0.508195, 0.209525, 0.750947, 0.779026, -1.112013, -0.224406, 0.047446, 0.958945, 0.109992, -0.594214, 0.277417, 0.37689, -0.159767, -0.093457, -0.