{"stype": "Sentence", "agent": "M4", "tr": "\" 즉, 모노카메라는 주변에 대한 이미지를 제한적으로만 담고 있으며, 시야 범위도 150m에 그치지만, \"", "doc_org": " Sie bilden die Umwelt also nur begrenzt räumlich ab und haben nur eine Reichweite von 150 Metern.", "doc": "T4", "embedding": [0.226065, 0.949097, 0.972494, 0.328963, -0.120803, -1.379604, 0.506213, 0.123337, 0.31026, -0.25932, -0.140704, -0.191215, -0.23963, -0.358217, -0.166577, 0.712158, -0.287106, -0.389594, 0.377963, -0.484974, 0.945563, -0.671785, -0.101252, -0.262934, 2.083295, -0.160183, 0.870829, 0.504555, -0.444499, -1.663946, 0.236447, -0.113703, -0.339295, 0.412874, 0.554362, 0.690371, -0.922202, 0.065431, 1.133386, 0.949552, 0.146707, 0.406768, -0.320751, -0.054285, -0.960294, -0.139538, -0.246213, 0.534208, 0.432674, -0.615494, 0.815082, 0.09042, 0.457736, 0.183882, -1.720074, 0.040809, 0.208131, -0.528972, 0.115287, 0.152916, -0.133891, 0.31403, -0.127991, -0.946604, 0.587394, 0.844724, 0.116393, 0.425385, -0.370305, 0.543695, 0.466306, -0.532036, -0.0539, -0.665351, -0.905007, -0.373572, 0.715822, 0.771415, 0.725098, -0.278156, -0.17369, -0.350568, 0.047487, 0.429693, 0.430954, 0.791567, -0.003201, 0.719187, -0.232763, 0.845075, 0.508894, -0.846464, -0.651455, -0.028034, -0.215832, 0.155367, -0.913125, -0.192275, -0.641203, 0.117469, 0.597831, 0.89988, -0.711926, -0.32992, 1.015731, 0.046232, -0.163686, 0.430441, 0.594314, -0.74755, 0.205984, 0.44282, 0.283453, -0.967431, -0.584975, -0.186426, -0.27259, 0.202886, -0.746499, -0.84227, -0.508343, 0.796052, -0.109573, -0.534082, -0.821059, -0.976849, 0.099723, -0.095813, 0.969585, -0.764755, 1.337193, -1.36947, -0.296191, 0.036919, 0.649913, 0.050145, -0.375277, 0.746179, 0.651846, 0.831418, 0.219264, 0.179867, -0.803909, 0.152177, 0.636326, 0.962272, -0.397868, 0.370156, -0.472362, -0.127985, 0.562883, -0.75597, -0.227412, 0.4647, -0.016476, -0.300544, 1.303612, 0.653612, -0.891963, 0.460675, -0.185669, 0.456287, 0.012763, -0.646287, 0.414005, 1.016692, -0.069304, 0.812796, -0.475262